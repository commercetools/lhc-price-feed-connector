# Local development only. Deployed, the CTP_* values are injected by Connect from the API Client it
# generates from inheritAs.apiClient.scopes.
CTP_PROJECT_KEY=
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_SCOPE=
# The Import API is a separate host; derived from CTP_API_URL unless set.
CTP_IMPORT_URL=

IMPORT_CONTAINER_KEY=lhc-price-feed

# The feed: a CSV file. Deployed, an https:// URL (S3/Blob/GCS object, SFTP gateway, or the raw file in
# the connector's Git repo). Locally, a file path also works.
FEED_SOURCE=csv
FEED_URL=../samples/prices.csv
# Optional Authorization header for a protected host — secured configuration when deployed.
FEED_AUTH_HEADER=
FEED_TIMEOUT_SECONDS=30
MAX_FEED_BYTES=5242880
# Skip a run whose file is byte-identical to the last fully successful import.
SKIP_UNCHANGED_FEED=true
# Read, validate and resolve keys, then report — submit nothing.
DRY_RUN=false

# Custom Object container for the run lock and the last-run record (and, with FEED_SOURCE=custom-object,
# the feed document FEED_KEY holding { rows: [{ sku, currencyCode, centAmount, country? }] }).
FEED_CONTAINER=lhc-price-feed
FEED_KEY=pending

# A job has no concurrency guard from the platform; this one locks. A lock older than this is assumed
# abandoned and taken over.
LOCK_STALE_MINUTES=45
POLL_TIMEOUT_SECONDS=120
POLL_INTERVAL_SECONDS=5

LOG_LEVEL=info
